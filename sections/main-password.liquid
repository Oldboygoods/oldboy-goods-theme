<div class="page-content">
  <h1 class="h1">{{ shop.name }}</h1>
  <div class="page-content__body body-l">
    {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'storefront_password' -%}
      {{ form.errors | default_errors }}
      <div class="inline-form" style="margin-top: 32px;">
        <label class="visually-hidden" for="Password">Password</label>
        <input id="Password" type="password" name="password" placeholder="Password" style="flex:1 1 auto; min-width:0; background:transparent; border:0; padding:16px 0; font-size: var(--fs-body-l);">
        <button class="link-l" type="submit">Enter</button>
      </div>
    {%- endform -%}
  </div>
</div>

{% schema %}
{ "name": "Password" }
{% endschema %}
