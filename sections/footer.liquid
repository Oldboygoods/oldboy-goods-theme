<footer class="site-footer">
  <div class="site-footer__menus">
    {%- for block in section.blocks -%}
      {%- assign menu = linklists[block.settings.menu] -%}
      <div class="site-footer__col" {{ block.shopify_attributes }}>
        <h2 class="h4">{{ block.settings.heading | escape }}</h2>
        <ul class="body">
          {%- if block.settings.menu != blank and menu.links.size > 0 -%}
            {%- for link in menu.links -%}
              <li><a class="link-underline" href="{{ link.url }}">{{ link.title | escape }}</a></li>
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..6) -%}
              {%- capture label_key %}link_{{ i }}_label{% endcapture -%}
              {%- capture url_key %}link_{{ i }}_url{% endcapture -%}
              {%- assign label = block.settings[label_key] -%}
              {%- if label != blank -%}
                <li><a class="link-underline" href="{{ block.settings[url_key] | default: '#' }}">{{ label | escape }}</a></li>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </ul>
      </div>
    {%- endfor -%}
  </div>

  <div class="site-footer__signup">
    <div class="site-footer__mark">
      {%- if settings.footer_mark != blank -%}
        {{ settings.footer_mark | image_url: width: 300 | image_tag: loading: 'lazy', alt: '' }}
      {%- else -%}
        <img src="{{ 'logo-mark.svg' | asset_url }}" alt="" width="116" height="183" loading="lazy">
      {%- endif -%}
    </div>
    <div class="site-footer__form">
      {%- form 'customer', id: 'FooterNewsletter' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="inline-form">
          <label class="visually-hidden" for="FooterNewsletterEmail">Email address</label>
          <input id="FooterNewsletterEmail" type="email" name="contact[email]" placeholder="Email address" autocomplete="email" required>
          <button class="link-l" type="submit">Subscribe</button>
        </div>
        {%- if form.posted_successfully? -%}
          <p class="form-message" role="status">{{ section.settings.success_message | escape }}</p>
        {%- elsif form.errors -%}
          <p class="form-message" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
        {%- endif -%}
      {%- endform -%}
      <p class="small">{{ section.settings.consent_text }}</p>
    </div>
  </div>
</footer>
<div class="site-footer__legal small">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</div>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "success_message",
      "label": "Sign-up success message",
      "default": "Thanks — you're on the list."
    },
    {
      "type": "inline_richtext",
      "id": "consent_text",
      "label": "Text under the sign-up form",
      "default": "By providing your email address, you agree to our privacy policy"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Link column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu (optional)",
          "info": "If chosen, the menu's links are used instead of the links below."
        },
        {
          "type": "text",
          "id": "link_1_label",
          "label": "Link 1 label"
        },
        {
          "type": "text",
          "id": "link_1_url",
          "label": "Link 1 address",
          "info": "e.g. /collections/furniture or /pages/cookies. Leave empty for a placeholder link."
        },
        {
          "type": "text",
          "id": "link_2_label",
          "label": "Link 2 label"
        },
        {
          "type": "text",
          "id": "link_2_url",
          "label": "Link 2 address"
        },
        {
          "type": "text",
          "id": "link_3_label",
          "label": "Link 3 label"
        },
        {
          "type": "text",
          "id": "link_3_url",
          "label": "Link 3 address"
        },
        {
          "type": "text",
          "id": "link_4_label",
          "label": "Link 4 label"
        },
        {
          "type": "text",
          "id": "link_4_url",
          "label": "Link 4 address"
        },
        {
          "type": "text",
          "id": "link_5_label",
          "label": "Link 5 label"
        },
        {
          "type": "text",
          "id": "link_5_url",
          "label": "Link 5 address"
        },
        {
          "type": "text",
          "id": "link_6_label",
          "label": "Link 6 label"
        },
        {
          "type": "text",
          "id": "link_6_url",
          "label": "Link 6 address"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        {
          "type": "menu",
          "settings": {
            "heading": "Shop"
          }
        },
        {
          "type": "menu",
          "settings": {
            "heading": "Help"
          }
        },
        {
          "type": "menu",
          "settings": {
            "heading": "About"
          }
        },
        {
          "type": "menu",
          "settings": {
            "heading": "Legal"
          }
        }
      ]
    }
  ]
}
{% endschema %}
