<footer class="site-footer">
  <div class="site-footer__menus">
    {%- for block in section.blocks -%}
      {%- assign menu = linklists[block.settings.menu] -%}
      <div class="site-footer__col" {{ block.shopify_attributes }}>
        <h2 class="h4">{{ block.settings.heading | escape }}</h2>
        {%- if menu.links.size > 0 -%}
          <ul class="body">
            {%- for link in menu.links -%}
              <li><a class="link-underline" href="{{ link.url }}">{{ link.title | escape }}</a></li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>

  <div class="site-footer__signup">
    <div class="site-footer__mark">
      {%- if settings.footer_mark != blank -%}
        {{ settings.footer_mark | image_url: width: 300 | image_tag: loading: 'lazy', alt: '' }}
      {%- else -%}
        <img src="{{ 'logo-mark.svg' | asset_url }}" alt="" width="116" height="183" loading="lazy">
      {%- endif -%}
    </div>
    <div class="site-footer__form">
      {%- form 'customer', id: 'FooterNewsletter' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="inline-form">
          <label class="visually-hidden" for="FooterNewsletterEmail">Email address</label>
          <input id="FooterNewsletterEmail" type="email" name="contact[email]" placeholder="Email address" autocomplete="email" required>
          <button class="link-l" type="submit">Subscribe</button>
        </div>
        {%- if form.posted_successfully? -%}
          <p class="form-message" role="status">{{ section.settings.success_message | escape }}</p>
        {%- elsif form.errors -%}
          <p class="form-message" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
        {%- endif -%}
      {%- endform -%}
      <p class="small">{{ section.settings.consent_text }}</p>
    </div>
  </div>
</footer>
<div class="site-footer__legal small">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</div>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "success_message",
      "label": "Sign-up success message",
      "default": "Thanks — you're on the list."
    },
    {
      "type": "inline_richtext",
      "id": "consent_text",
      "label": "Text under the sign-up form",
      "default": "By providing your email address, you agree to our privacy policy"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "menu", "settings": { "heading": "Shop" } },
        { "type": "menu", "settings": { "heading": "Help" } },
        { "type": "menu", "settings": { "heading": "About" } },
        { "type": "menu", "settings": { "heading": "Legal" } }
      ]
    }
  ]
}
{% endschema %}
