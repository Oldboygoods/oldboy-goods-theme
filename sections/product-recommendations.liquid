{%- comment -%}
  Loaded with JavaScript via the Product Recommendations API.
  On first render it outputs an empty shell; theme.js fetches this section
  again with product_id and swaps in the result.
{%- endcomment -%}
<section class="recommendations" data-recommendations data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.count }}&intent=related">
  {%- if recommendations.performed? and recommendations.products_count > 0 -%}
    <div class="product-row__head">
      <h2 class="h4">{{ section.settings.heading | escape }}</h2>
    </div>
    <div class="product-row__grid" style="--cols: {{ section.settings.count }};">
      {%- for product in recommendations.products -%}
        {% render 'product-card', product: product, sizes: '(min-width: 750px) 25vw, 72vw' %}
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "You might like",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You might like" },
    { "type": "range", "id": "count", "label": "Products shown", "min": 2, "max": 6, "step": 1, "default": 4 }
  ]
}
{% endschema %}
